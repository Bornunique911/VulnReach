# Copy this file to .env.local and fill in your values.
# .env.local is loaded first by the app (see api/server.py) and is gitignored.

# ── Database ──────────────────────────────────────────────────────────────────
# Set automatically by docker-compose.yml when using the bundled postgres service.
# Override here if you point to an external database.
# DATABASE_URL=postgresql://vulnreach:vulnreach@db:5432/vulnreach

# ── Auth ──────────────────────────────────────────────────────────────────────
# Secret key used to sign JWT tokens. Generate with: openssl rand -hex 32
SECRET_KEY=change-me-generate-a-real-secret

# ── LLM Providers (at least one required for intelligent DAST / OpenAPI gen) ──
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# For local inference via Ollama leave both above blank and set:
# OLLAMA_BASE_URL=http://host.docker.internal:11434

# ── Work Directory ────────────────────────────────────────────────────────────
# Set automatically by docker-compose.yml. Only override if running outside Docker.
# VULNREACH_WORK_DIR=/tmp/vulnreach
