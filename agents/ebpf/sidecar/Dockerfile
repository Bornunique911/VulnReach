# VulnReach eBPF sidecar image.
#
# Injected alongside the user's target service via a docker-compose override
# generated by agents/ebpf/compose_injector.py.  Shares the target's PID
# namespace (pid: "service:<target>") to attach bpftrace probes, waits for
# Schemathesis traffic driven by the main agent, then writes
# /coverage/ebpf_coverage.json for the agent to read after compose exits.
#
# Architecture mirrors labs/ebpf-verify/agent/Dockerfile but adapted for
# production: no ground-truth generation, no comparison — trace, parse, write.
#
# This file is copied into the bind-mounted work dir by inject_sidecar() so
# the host Docker daemon can build it without needing access to /app.
#
# Host requirements:
#   - Linux kernel >= 4.9 (uprobes)
#   - /sys/kernel/debug:/sys/kernel/debug:ro bind-mounted into this container
#   - privileged: true  (or CAP_BPF + CAP_PERFMON + SYS_PTRACE on kernel >= 5.8)
#   - pid: "service:<target>"  to share the target's PID namespace

FROM python:3.11-slim

ARG DEBIAN_FRONTEND=noninteractive

# bpftrace  — eBPF tracer (Debian Bookworm ships 0.17+; uses BTF, no headers needed)
# procps    — pgrep for PID discovery in the shared PID namespace
# binutils  — readelf (USDT probe detection) + addr2line (Go symbol resolution)
RUN apt-get update && apt-get install -y --no-install-recommends \
    bpftrace \
    procps \
    binutils \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY sidecar_entrypoint.py ./sidecar_entrypoint.py

ENV PYTHONUNBUFFERED=1

CMD ["python3", "sidecar_entrypoint.py"]
