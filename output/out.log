                            "Title": "Werkzeug: Werkzeug: Denial of service via Windows device names in path segments",
                            "CweIDs": [
                                "CWE-67"
                            ],
                            "Status": "fixed",
                            "PkgName": "Werkzeug",
                            "Severity": "MEDIUM",
