                                "https://github.com/pallets/jinja/security/advisories/GHSA-q2x7-8rv6-6q7h",
                                "https://linux.oracle.com/cve/CVE-2024-56326.html",
                                "https://linux.oracle.com/errata/ELSA-2025-1250.html",
